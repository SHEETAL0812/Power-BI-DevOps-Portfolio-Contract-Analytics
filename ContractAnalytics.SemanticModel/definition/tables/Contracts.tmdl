table Contracts
	lineageTag: 0b8d5772-2406-489c-85a9-2fa33ec72c9a

	measure 'Total Contracts' = COUNTROWS(Contracts)
		formatString: #,0
		displayFolder: Volume
		lineageTag: 03984044-2f39-4a12-a789-125b806c9747

	measure 'Active Contracts' = CALCULATE(COUNTROWS(Contracts), Contracts[Status] = "Active")
		formatString: #,0
		displayFolder: Volume
		lineageTag: 71e1b8e5-7199-4652-aca0-9a539bf08826

	measure 'Total Value (EUR)' = SUM(Contracts[ContractValueEUR])
		formatString: #,0
		displayFolder: Value
		lineageTag: 450a356c-fc67-433e-9edf-2bd59ae78757

	measure 'Avg Review Cycle (Days)' = AVERAGE(Contracts[ReviewCycleDays])
		formatString: 0.0
		displayFolder: Process
		lineageTag: 1c8d891b-b68a-4eb2-b08c-2ed861594c0f

	measure 'Expiring Next 90 Days' = CALCULATE(COUNTROWS(Contracts), Contracts[Status] = "Active", Contracts[EndDate] >= TODAY(), Contracts[EndDate] <= TODAY() + 90)
		formatString: #,0
		displayFolder: Risk
		lineageTag: fd4cbe0b-04b6-4840-ad2a-703436d867b7

	measure 'Avg Contract Value (EUR)' = AVERAGE(Contracts[ContractValueEUR])
		formatString: #,0
		displayFolder: Value

	measure 'Expired Contracts' = CALCULATE(COUNTROWS(Contracts), Contracts[Status] = "Expired")
		formatString: #,0
		displayFolder: Volume

	measure 'Active Share %' = DIVIDE([Active Contracts], [Total Contracts])
		formatString: 0.0%
		displayFolder: Volume

	column ContractID
		dataType: string
		lineageTag: f95a7136-638b-4805-b265-3b792a879901
