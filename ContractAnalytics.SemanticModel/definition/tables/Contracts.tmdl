	partition Contracts = m
		mode: import
		source =
				let
				  Source = Csv.Document(File.Contents("C:\Users\Sheetal\Dropbox\PC\Desktop\Advanced PowerBi Portfolio\Power-BI-DevOps-Portfolio-Contract-Analytics\data\Contracts.csv"), [Delimiter = ",", Columns = 11, QuoteStyle = QuoteStyle.None]),
				  #"Promoted headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				  #"Changed column type" = Table.TransformColumnTypes(#"Promoted headers", {{"ContractID", type text}, {"CounterpartyID", Int64.Type}, {"DepartmentID", Int64.Type}, {"ContractType", type text}, {"Status", type text}, {"CreatedDate", type date}, {"SignedDate", type date}, {"StartDate", type date}, {"EndDate", type date}, {"ContractValueEUR", Int64.Type}, {"ReviewCycleDays", Int64.Type}})
				in
				  #"Changed column type"

	annotation PBI_ResultType = Table

